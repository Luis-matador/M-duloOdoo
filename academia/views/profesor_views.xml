<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_academia_profesor_tree" model="ir.ui.view">
        <field name="name">academia.profesor.tree</field>
        <field name="model">academia.profesor</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre_completo"/>
                <field name="email"/>
                <field name="telefono"/>
                <field name="titulacion"/>
                <field name="especialidad"/>
                <field name="activo"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_academia_profesor_form" model="ir.ui.view">
        <field name="name">academia.profesor.form</field>
        <field name="model">academia.profesor</field>
        <field name="arch" type="xml">
            <form string="Profesor">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="nombre_completo" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="apellidos"/>
                            <field name="email"/>
                            <field name="telefono"/>
                        </group>
                        <group>
                            <field name="titulacion"/>
                            <field name="especialidad"/>
                            <field name="fecha_contratacion"/>
                            <field name="activo"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cursos">
                            <field name="curso_ids">
                                <list>
                                    <field name="titulo"/>
                                    <field name="nivel"/>
                                    <field name="precio"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sesiones">
                            <field name="sesion_ids">
                                <list>
                                    <field name="display_name"/>
                                    <field name="fecha_inicio"/>
                                    <field name="duracion"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_academia_profesor_search" model="ir.ui.view">
        <field name="name">academia.profesor.search</field>
        <field name="model">academia.profesor</field>
        <field name="arch" type="xml">
            <search string="Buscar Profesores">
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="especialidad"/>
                <separator/>
                <filter string="Activos" name="activos" domain="[('activo','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_academia_profesor" model="ir.actions.act_window">
        <field name="name">Profesores</field>
        <field name="res_model">academia.profesor</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
