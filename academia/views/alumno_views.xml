<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_academia_alumno_tree" model="ir.ui.view">
        <field name="name">academia.alumno.tree</field>
        <field name="model">academia.alumno</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre_completo"/>
                <field name="email"/>
                <field name="telefono"/>
                <field name="fecha_nacimiento"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_academia_alumno_form" model="ir.ui.view">
        <field name="name">academia.alumno.form</field>
        <field name="model">academia.alumno</field>
        <field name="arch" type="xml">
            <form string="Alumno">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="nombre_completo" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="apellidos"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="telefono"/>
                            <field name="fecha_nacimiento"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sesiones">
                            <field name="sesion_ids">
                                <list>
                                    <field name="display_name"/>
                                    <field name="fecha_inicio"/>
                                    <field name="duracion"/>
                                </list>
                            </field>
                        </page>
                        <page string="Clases">
                            <field name="clase_ids">
                                <list>
                                    <field name="nombre"/>
                                    <field name="dia_semana"/>
                                    <field name="hora_inicio" widget="float_time"/>
                                    <field name="hora_fin" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Matrículas">
                            <field name="matricula_ids">
                                <list>
                                    <field name="sesion_id"/>
                                    <field name="fecha_matricula"/>
                                    <field name="state" widget="badge" decoration-info="state == 'borrador'" decoration-warning="state == 'confirmada'" decoration-success="state == 'pagada'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Facturas">
                            <field name="facturacion_ids">
                                <list>
                                    <field name="numero_factura"/>
                                    <field name="concepto"/>
                                    <field name="cantidad"/>
                                    <field name="fecha_pago"/>
                                    <field name="estado"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_academia_alumno_search" model="ir.ui.view">
        <field name="name">academia.alumno.search</field>
        <field name="model">academia.alumno</field>
        <field name="arch" type="xml">
            <search string="Buscar Alumnos">
                <field name="nombre"/>
                <field name="apellidos"/>
                <field name="email"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_academia_alumno" model="ir.actions.act_window">
        <field name="name">Alumnos</field>
        <field name="res_model">academia.alumno</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
